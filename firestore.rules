rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmadimam3000@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidRentalSnapshot(data) {
      return data.keys().hasAll(['ownerId', 'updatedAt', 'version']) &&
        data.keys().hasOnly(['ownerId', 'updatedAt', 'version']) &&
        data.ownerId is string &&
        data.ownerId.size() >= 1 &&
        data.ownerId.size() <= 128 &&
        data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.updatedAt is timestamp &&
        data.version is int &&
        data.version >= 1;
    }

    match /rentalSnapshots/{snapshotId} {
      allow get: if isSignedIn() && isValidId(snapshotId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(snapshotId) && isValidRentalSnapshot(incoming()) && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isValidId(snapshotId) && isValidRentalSnapshot(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'version']);
      allow delete: if isAdmin() && isValidId(snapshotId);
    }
  }
}
